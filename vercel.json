{
  "functions": {
    "api/market.py": {
      "maxDuration": 10
    },
    "api/refresh.py": {
      "maxDuration": 30
    },
    "api/report.py": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/refresh",
      "schedule": "15 15 * * 1-5"
    }
  ]
}